# ~/.gradle/init.d/mirror.gradle.kts
val mirror = "https://maven-central.storage-download.googleapis.com/maven2/"
fun fix(repos: org.gradle.api.artifacts.dsl.RepositoryHandler) {
    repos.removeIf { it is MavenArtifactRepository && it.url.host.contains("google.com") }
    repos.withType(MavenArtifactRepository::class.java).configureEach {
        if (url.toString().contains("repo.maven.apache.org") || url.toString().contains("repo1.maven.org")) setUrl(mirror)
    }
    if (repos.findByName("centralMirror") == null) {
        val m = repos.maven { name = "centralMirror"; setUrl(mirror) }
        repos.remove(m)
        (repos as MutableList<org.gradle.api.artifacts.repositories.ArtifactRepository>).add(0, m)
    }
}
beforeSettings {
    fix(pluginManagement.repositories)
    pluginManagement.repositories.gradlePluginPortal()
    settingsEvaluated {
        fix(pluginManagement.repositories)
        fix(dependencyResolutionManagement.repositories)
    }
}
allprojects {
    buildscript { fix(repositories) }
    fix(repositories)
}

